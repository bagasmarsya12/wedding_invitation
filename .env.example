# DATABASE / STORAGE: DB (D1) and BUCKET (R2) are Worker bindings from .openai/hosting.json.
# AUTH: configure at least one admin allowlist value in the hosting environment.
ADMIN_USER_IDS=
ADMIN_EMAILS=

# APP URL: set to the final HTTPS domain when available; never put an invite token here.
NEXT_PUBLIC_SITE_URL=

# MAP: OpenFreeMap is used without an application key.
# EMAIL / MONITORING / ANALYTICS: no provider or secret is required for core flows.
